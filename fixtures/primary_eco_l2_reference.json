{
  "schemaVersion": 1,
  "description": "Referencia independiente del conector Primary Eco Valores XOMS: config de entorno (PRIMARY_BASE_URL/PRIMARY_WS_URL/ECO_MATRIZ_*), parser MERV con alias T1, selección del universo BYMA L2 (Merval + CEDEARs + GFGC*/GFGV*), decisión del tick ARS de GGAL y microestructura 5 puntas (orden + spread/imbalance). Sin valores de credenciales.",
  "configCases": [
    {
      "id": "eco_xoms_base_url_with_matriz_credentials",
      "env": {
        "PRIMARY_BASE_URL": "https://api.eco.xoms.com.ar",
        "ECO_MATRIZ_USERNAME": "matriz_user",
        "ECO_MATRIZ_PASSWORD": "matriz_pass"
      },
      "expected": {
        "apiUrl": "https://api.eco.xoms.com.ar",
        "wsUrl": "wss://api.eco.xoms.com.ar/",
        "usernameConfigured": true,
        "passwordConfigured": true,
        "configured": true
      }
    },
    {
      "id": "legacy_primary_api_url_and_credentials",
      "env": {
        "PRIMARY_API_URL": "https://api.remarkets.primary.com.ar",
        "PRIMARY_USERNAME": "primary_user",
        "PRIMARY_PASSWORD": "primary_pass"
      },
      "expected": {
        "apiUrl": "https://api.remarkets.primary.com.ar",
        "wsUrl": "wss://api.remarkets.primary.com.ar/",
        "usernameConfigured": true,
        "passwordConfigured": true,
        "configured": true
      }
    },
    {
      "id": "explicit_ws_url_wins_and_trailing_slash_trimmed",
      "env": {
        "PRIMARY_BASE_URL": "https://api.eco.xoms.com.ar/",
        "PRIMARY_WS_URL": "wss://ws.eco.xoms.com.ar/",
        "PRIMARY_USERNAME": "primary_user",
        "PRIMARY_PASSWORD": "primary_pass",
        "ECO_MATRIZ_USERNAME": "matriz_user",
        "ECO_MATRIZ_PASSWORD": "matriz_pass"
      },
      "expected": {
        "apiUrl": "https://api.eco.xoms.com.ar",
        "wsUrl": "wss://ws.eco.xoms.com.ar/",
        "usernameConfigured": true,
        "passwordConfigured": true,
        "configured": true
