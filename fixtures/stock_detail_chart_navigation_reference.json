        "from": 900.25,
        "to": 1249.5
      },
      "incoming": {
        "from": 900.25005,
        "to": 1249.49996
      },
      "tolerance": 0.0001,
      "expected": false
    },
    {
      "name": "apply_when_user_scrolled_beyond_tolerance",
      "current": {
        "from": 900.25,
