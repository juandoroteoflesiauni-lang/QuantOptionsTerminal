{
  "name": "quant-options-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "node --env-file-if-exists=.env node_modules/vite-node/vite-node.mjs --script src/server/index.ts",
    "dev:terminal": "node --env-file-if-exists=.env node_modules/vite-node/vite-node.mjs --script src/server/index.ts --with-web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --testTimeout=15000",
    "smoke:next-url": "vitest run --config vitest.smoke.mts",
    "feeds:check": "node node_modules/vite-node/vite-node.mjs --script tools/check_live_feeds.ts",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.2",
    "eslint": "^9.22.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "ws": "^8.23.0"
  }
}
